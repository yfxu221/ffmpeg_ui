{
  "name": "frameforge",
  "productName": "FrameForge",
  "version": "0.1.0",
  "description": "A quiet desktop workspace for MP4 and GIF.",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "author": "FrameForge",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "test": "npm run build && node --test tests/engine.test.cjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:packaged": "node scripts/smoke.mjs --packaged",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  }
}
